/* ============================================================
   🌙 قمر الشام — ui/profile.js v2.0
   تصميم فاخر — Cover + Avatar Ring + Glass Cards
   ============================================================ */
(function () {
  'use strict';
  if (window.QamarProfile) return;

  var VERSION = '2.0';
  var MODAL_ID = 'qamar-profile-modal';
  var St = { inited: false, open: false, currentUid: null, isSelf: false };

  function $id(id) { return document.getElementById(id); }

  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function emit(name, data) {
    try { if (window.EventBus && window.EventBus.emit) window.EventBus.emit(name, data); } catch (e) {}
  }

  function getCurrentUid() {
    try {
      if (window.QamarAuth && typeof window.QamarAuth.getUid === 'function') return window.QamarAuth.getUid();
      if (window.auth && window.auth.currentUser) return window.auth.currentUser.uid;
    } catch (e) {}
    return null;
  }

  function isKing() {
    try { return window.QamarRanks && window.QamarRanks.isKing && window.QamarRanks.isKing(); } catch (e) { return false; }
  }

  function timeAgo(ts) {
    if (!ts) return '—';
    var s = Math.floor((Date.now() - ts) / 1000);
    if (s < 60) return 'الآن';
    var m = Math.floor(s / 60);
    if (m < 60) return m + ' د';
    var h = Math.floor(m / 60);
    if (h < 24) return h + ' س';
    var d = Math.floor(h / 24);
    if (d < 30) return d + ' ي';
    try { return new Date(ts).toLocaleDateString('ar-EG'); } catch (e) { return ''; }
  }

  function toast(msg, kind) {
    try {
      if (window.EventBus && window.EventBus.emit) {
        window.EventBus.emit('toast:show', { message: msg, kind: kind || 'info' });
      }
    } catch (e) {}
  }

  function getRankInfo(rank, level) {
    var r = rank || 'User';
    var icons = { 'King': '👑', 'Queen': '👸', 'Master Owner': '🌟', 'Room Owner': '🛡️',
      'Grand Owner': '💎', 'Owner': '🏆', 'Super Admin': '🎖️', 'Admin': '🛠️',
      'Premium': '💠', 'User': '👤' };
    var colors = { 'King': '#ffd700', 'Queen': '#ff69b4', 'Master Owner': '#ffa500',
      'Room Owner': '#3498db', 'Grand Owner': '#9b59b6', 'Owner': '#e67e22',
      'Super Admin': '#f1c40f', 'Admin': '#1abc9c', 'Premium': '#e84393', 'User': '#9ca3af' };
    return {
      icon: icons[r] || '👤',
      label: r,
      color: colors[r] || '#9ca3af'
    };
  }

  function fetchUser(uid) {
    return new Promise(function (resolve) {
      if (!window.QamarFB || typeof window.QamarFB.get !== 'function') { resolve(null); return; }
      try {
        window.QamarFB.get('users/' + uid).then(function (d) { resolve(d || null); })
          .catch(function () { resolve(null); });
      } catch (e) { resolve(null); }
    });
  }

  function fetchPoints(uid) {
    return new Promise(function (resolve) {
      if (!window.QamarFB || typeof window.QamarFB.get !== 'function') { resolve(0); return; }
      try {
        window.QamarFB.get('bot_data/quiz/scores/' + uid).then(function (v) {
          resolve((v && Number(v.points)) || Number(v) || 0);
        }).catch(function () { resolve(0); });
      } catch (e) { resolve(0); }
    });
  }

  /* ==================== CSS ==================== */

  function injectStyle() {
    if ($id('qp-style')) return;
    var st = document.createElement('style');
    st.id = 'qp-style';
    st.textContent =
      '@keyframes qpSlideUp{from{transform:translateY(60px);opacity:0}to{transform:translateY(0);opacity:1}}' +
      '@keyframes qpAvatarIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}' +
      '@keyframes qpShimmer{0%{background-position:0% 50%}100%{background-position:200% 50%}}' +
      '@keyframes qpGlow{0%,100%{box-shadow:0 0 20px rgba(212,175,55,.4),0 0 40px rgba(212,175,55,.2)}' +
        '50%{box-shadow:0 0 30px rgba(212,175,55,.6),0 0 60px rgba(212,175,55,.3)}}' +
      '.qp-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);' +
        '-webkit-backdrop-filter:blur(8px);z-index:16500;display:flex;align-items:flex-end;' +
        'justify-content:center;font-family:inherit;direction:rtl;padding:0}' +
      '.qp-card{width:100%;max-width:520px;max-height:94vh;overflow-y:auto;' +
        'background:linear-gradient(180deg,#0a0616 0%,#050508 100%);' +
        'border-top-left-radius:24px;border-top-right-radius:24px;' +
        'border:1px solid rgba(212,175,55,.35);border-bottom:none;' +
        'position:relative;animation:qpSlideUp .4s cubic-bezier(.2,.9,.3,1);' +
        '-webkit-overflow-scrolling:touch}' +
      '.qp-card::-webkit-scrollbar{width:0}' +
      '.qp-close{position:absolute;top:12px;right:12px;z-index:10;width:36px;height:36px;' +
        'border-radius:50%;background:rgba(0,0,0,.55);backdrop-filter:blur(10px);' +
        'border:1px solid rgba(255,255,255,.18);color:#fff;font-size:15px;cursor:pointer;' +
        'font-family:inherit;display:flex;align-items:center;justify-content:center;' +
        'transition:all .2s}' +
      '.qp-close:active{transform:scale(.9)}' +
      '.qp-cover{position:relative;height:170px;overflow:hidden;background:#0a0616;' +
        'border-top-left-radius:24px;border-top-right-radius:24px}' +
      '.qp-cover::after{content:"";position:absolute;inset:0;' +
        'background:linear-gradient(180deg,rgba(10,6,22,.1) 0%,rgba(5,5,8,.5) 60%,#050508 100%);' +
        'pointer-events:none}' +
      '.qp-avatar-wrap{position:relative;margin-top:-58px;display:flex;justify-content:center;' +
        'z-index:3;animation:qpAvatarIn .5s cubic-bezier(.2,.9,.3,1) .1s both}' +
      '.qp-avatar-ring{position:relative;padding:5px;border-radius:50%;' +
        'background:linear-gradient(135deg,#ffd700 0%,#d4af37 40%,#b8860b 70%,#ffd700 100%);' +
        'background-size:200% 200%;animation:qpGlow 3s ease-in-out infinite}' +
      '.qp-avatar{width:116px;height:116px;border-radius:50%;object-fit:cover;' +
        'background:#0a0616;display:block;border:3px solid #050508}' +
      '.qp-name{text-align:center;padding:16px 20px 4px;font-size:24px;font-weight:900;' +
        'color:#f3f4f6;line-height:1.3;word-break:break-word}' +
      '.qp-code{text-align:center;font-size:12px;color:#d4af37;font-weight:900;' +
        'letter-spacing:2px;padding:2px 0 12px;opacity:.9}' +
      '.qp-bio{text-align:center;padding:0 26px 14px;color:#9ca3af;font-size:13px;' +
        'line-height:1.7;word-break:break-word;font-style:italic}' +
      '.qp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 18px 14px}' +
      '.qp-stat{text-align:center;padding:12px 6px;border-radius:14px;' +
        'background:rgba(255,255,255,.035);border:1px solid rgba(212,175,55,.18);' +
        'backdrop-filter:blur(10px);transition:all .2s}' +
      '.qp-stat:active{transform:scale(.96)}' +
      '.qp-stat-ico{font-size:22px;margin-bottom:4px;line-height:1}' +
      '.qp-stat-val{font-size:13px;font-weight:900;color:#f3f4f6;' +
        'white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 4px}' +
      '.qp-stat-lbl{font-size:9.5px;color:#6b7280;margin-top:3px;letter-spacing:.5px}' +
      '.qp-info{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;padding:0 18px 14px}' +
      '.qp-chip{padding:6px 13px;border-radius:9999px;background:rgba(212,175,55,.1);' +
        'border:1px solid rgba(212,175,55,.28);font-size:11.5px;color:#f3f4f6;' +
        'font-weight:700;backdrop-filter:blur(10px)}' +
      '.qp-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;' +
        'padding:4px 18px 16px}' +
      '.qp-action{display:flex;flex-direction:column;align-items:center;gap:5px;' +
        'padding:12px 4px;border-radius:14px;' +
        'background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);' +
        'cursor:pointer;font-family:inherit;transition:all .15s}' +
      '.qp-action:active{transform:scale(.94);background:rgba(212,175,55,.1)}' +
      '.qp-action-ico{font-size:22px;line-height:1}' +
      '.qp-action-lbl{font-size:10px;font-weight:900;letter-spacing:.3px}' +
      '.qp-poetry{margin:0 18px 14px;padding:16px;border-radius:16px;' +
        'border:1px solid rgba(168,85,247,.28);position:relative;overflow:hidden;' +
        'background:linear-gradient(135deg,rgba(168,85,247,.1),rgba(124,58,237,.05))}' +
      '.qp-poetry::before{content:"❝";position:absolute;top:2px;right:14px;' +
        'font-size:36px;color:rgba(168,85,247,.35);line-height:1;font-family:serif}' +
      '.qp-poetry-txt{position:relative;color:#f3f4f6;font-size:14px;line-height:1.9;' +
        'font-style:italic;text-align:center;white-space:pre-wrap;padding-top:6px}' +
      '.qp-music{margin:0 18px 16px;padding:12px 14px;border-radius:14px;' +
        'background:linear-gradient(135deg,rgba(212,175,55,.14),rgba(184,134,11,.06));' +
        'border:1px solid rgba(212,175,55,.32);display:flex;align-items:center;gap:12px}' +
      '.qp-music-btn{width:42px;height:42px;border-radius:50%;' +
        'background:linear-gradient(135deg,#ffd700,#d4af37 60%,#b8860b);' +
        'color:#0a0616;font-size:16px;border:none;cursor:pointer;font-family:inherit;' +
        'display:flex;align-items:center;justify-content:center;font-weight:900;' +
        'box-shadow:0 4px 14px rgba(212,175,55,.4)}' +
      '.qp-music-txt{flex:1;min-width:0}' +
      '.qp-music-title{font-size:12px;font-weight:900;color:#f3f4f6}' +
      '.qp-music-sub{font-size:10px;color:#9ca3af;margin-top:2px}' +
      '.qp-bottom{height:24px}' +
      '.qpf-ov{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:17000;' +
        'display:flex;align-items:center;justify-content:center;padding:20px;direction:rtl}' +
      '.qpf-card{width:100%;max-width:420px;background:#0a0616;' +
        'border:1px solid rgba(212,175,55,.4);border-radius:20px;padding:16px;' +
        'max-height:82vh;overflow-y:auto}' +
      '.qpf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}' +
      '.qpf-tile{padding:14px 6px;border-radius:12px;background:rgba(255,255,255,.04);' +
        'border:2px solid rgba(255,255,255,.08);color:#f3f4f6;font-family:inherit;' +
        'font-size:11px;font-weight:900;cursor:pointer;display:flex;flex-direction:column;' +
        'align-items:center;gap:6px;transition:all .15s}' +
      '.qpf-tile:active{transform:scale(.94)}' +
      '.qpf-dot{width:38px;height:38px;border-radius:50%;display:block}';
    document.head.appendChild(st);
  }

  /* ==================== HTML pieces ==================== */

  function renderCover(user) {
    var type = user.coverType || 'gradient';
    var val = user.cover || '';
    var inner = '';

    if (type === 'video' && val) {
      inner = '<video src="' + esc(val) + '" autoplay muted loop playsinline ' +
        'style="width:100%;height:100%;object-fit:cover;opacity:.75"></video>';
    } else if (type === 'image' && val) {
      inner = '<img src="' + esc(val) + '" style="width:100%;height:100%;object-fit:cover;opacity:.75" ' +
        'onerror="this.style.display=\'none\'">';
    } else if (type === 'color' && val) {
      inner = '<div style="width:100%;height:100%;background:' + esc(val) + '"></div>';
    } else if (type === 'gradient' && val) {
      var g = Array.isArray(val) ? ('linear-gradient(135deg,' + val[0] + ' 0%,' + val[1] + ' 100%)') : val;
      inner = '<div style="width:100%;height:100%;background:' + esc(g) + '"></div>';
    } else {
      // Default premium gradient
      inner = '<div style="width:100%;height:100%;' +
        'background:linear-gradient(135deg,#1a0b2e 0%,#0a0616 40%,#2d1b4e 70%,#0a0616 100%)"></div>' +
        '<div style="position:absolute;inset:0;' +
        'background:radial-gradient(circle at 30% 30%,rgba(212,175,55,.15),transparent 60%),' +
        'radial-gradient(circle at 70% 70%,rgba(168,85,247,.15),transparent 60%)"></div>';
    }

    return '<div class="qp-cover">' + inner + '</div>';
  }

  function renderAvatar(user) {
    var src = user.avatar || ('https://ui-avatars.com/api/?name=' +
      encodeURIComponent(user.name || 'U') + '&background=1a1a2e&color=d4af37&size=200&bold=true');
    return '<div class="qp-avatar-wrap">' +
      '<div class="qp-avatar-ring">' +
        '<img class="qp-avatar" id="qp-avatar" src="' + esc(src) + '" ' +
          'onerror="this.src=\'https://ui-avatars.com/api/?name=U&background=1a1a2e&color=d4af37\'">' +
      '</div>' +
    '</div>';
  }

  function renderName(user) {
    var name = user.name || '—';
    var code = user.code || '';
    var html = '<div class="qp-name" id="qp-name">' + esc(name) + '</div>';
    if (code) html += '<div class="qp-code">' + esc(code) + '</div>';
    return html;
  }

  function renderBio(user) {
    if (!user.bio) return '';
    return '<div class="qp-bio">' + esc(user.bio) + '</div>';
  }

  function renderStats(user, points) {
    var rankInfo = getRankInfo(user.rank, user.rankLevel);
    return '<div class="qp-stats">' +
      statBox(rankInfo.icon, rankInfo.label, 'الرتبة', rankInfo.color) +
      statBox('⭐', String(points || 0), 'النقاط', '#ffd700') +
      statBox('🕒', timeAgo(user.lastSeen), 'آخر ظهور', '#84cc16') +
    '</div>';
  }

  function statBox(ico, val, lbl, color) {
    return '<div class="qp-stat">' +
      '<div class="qp-stat-ico">' + ico + '</div>' +
      '<div class="qp-stat-val" style="color:' + (color || '#f3f4f6') + '">' +
        esc(String(val).substring(0, 14)) + '</div>' +
      '<div class="qp-stat-lbl">' + esc(lbl) + '</div>' +
    '</div>';
  }

  function renderInfo(user) {
    var parts = [];
    if (user.country) parts.push('🌍 ' + esc(user.country));
    if (user.family)  parts.push('👨‍👩‍👧 ' + esc(user.family));
    if (user.gender) {
      var g = user.gender === 'male' ? '♂️ ذكر' : (user.gender === 'female' ? '♀️ أنثى' : '⚧ آخر');
      parts.push(g);
    }
    if (user.age) parts.push('🎂 ' + user.age);
    if (!parts.length) return '';
    return '<div class="qp-info">' +
      parts.map(function (p) { return '<span class="qp-chip">' + p + '</span>'; }).join('') +
    '</div>';
  }

  function renderActions(isSelf) {
    var buttons = [];
    if (isSelf) {
      buttons.push({ id: 'frames', ico: '🎨', lbl: 'إطار', color: '#ffd700' });
      buttons.push({ id: 'name-effect', ico: '✨', lbl: 'نمط', color: '#a855f7' });
      buttons.push({ id: 'edit', ico: '✏️', lbl: 'تعديل', color: '#84cc16' });
      buttons.push({ id: 'share', ico: '🔗', lbl: 'مشاركة', color: '#06b6d4' });
    } else {
      buttons.push({ id: 'pm', ico: '💬', lbl: 'رسالة', color: '#3b82f6' });
      buttons.push({ id: 'add-friend', ico: '➕', lbl: 'صديق', color: '#84cc16' });
      buttons.push({ id: 'report', ico: '🚨', lbl: 'إبلاغ', color: '#f59e0b' });
      buttons.push({ id: 'block', ico: '🚫', lbl: 'حظر', color: '#ef4444' });
    }

    return '<div class="qp-actions">' +
      buttons.map(function (b) {
        return '<button class="qp-action" data-action="' + b.id + '" type="button" ' +
          'style="color:' + b.color + ';border-color:' + b.color + '30">' +
          '<span class="qp-action-ico">' + b.ico + '</span>' +
          '<span class="qp-action-lbl">' + b.lbl + '</span>' +
        '</button>';
      }).join('') +
    '</div>';
  }

  function renderPoetry(user) {
    if (!user.poetry) return '';
    var bg = user.poetryBg
      ? 'background-image:linear-gradient(rgba(10,6,22,.7),rgba(10,6,22,.85)),url(' + esc(user.poetryBg) + ');' +
        'background-size:cover;background-position:center;'
      : '';
    return '<div class="qp-poetry" style="' + bg + '">' +
      '<div class="qp-poetry-txt">' + esc(user.poetry) + '</div>' +
    '</div>';
  }

  function renderMusic(user) {
    if (!user.musicURL) return '';
    return '<div class="qp-music">' +
      '<button class="qp-music-btn" id="qp-music-btn" type="button">▶</button>' +
      '<div class="qp-music-txt">' +
        '<div class="qp-music-title">🎵 موسيقى البروفايل</div>' +
        '<div class="qp-music-sub">اضغط للتشغيل</div>' +
      '</div>' +
      '<audio id="qp-music" src="' + esc(user.musicURL) + '" preload="none" style="display:none"></audio>' +
    '</div>';
  }

  /* ==================== Build ==================== */

  function build(user, points) {
    var old = $id(MODAL_ID);
    if (old) old.remove();

    injectStyle();

    var ov = document.createElement('div');
    ov.id = MODAL_ID;
    ov.className = 'qp-overlay';

    var card = document.createElement('div');
    card.className = 'qp-card';

    card.innerHTML =
      '<button class="qp-close" id="qp-close" type="button">✕</button>' +
      renderCover(user) +
      renderAvatar(user) +
      renderName(user) +
      renderBio(user) +
      renderStats(user, points) +
      renderInfo(user) +
      renderActions(St.isSelf) +
      renderPoetry(user) +
      renderMusic(user) +
      '<div class="qp-bottom"></div>';

    ov.appendChild(card);
    document.body.appendChild(ov);

    card.querySelector('#qp-close').addEventListener('click', close);
    ov.addEventListener('click', function (e) { if (e.target === ov) close(); });

    card.querySelectorAll('.qp-action').forEach(function (btn) {
      btn.addEventListener('click', function () {
        handleAction(btn.getAttribute('data-action'), user);
      });
    });

    // Music
    var musicBtn = card.querySelector('#qp-music-btn');
    var musicEl = card.querySelector('#qp-music');
    if (musicBtn && musicEl) {
      musicBtn.addEventListener('click', function () {
        if (musicEl.paused) {
          musicEl.play().then(function () { musicBtn.textContent = '⏸'; })
            .catch(function () { toast('تعذر التشغيل', 'error'); });
        } else {
          musicEl.pause();
          musicBtn.textContent = '▶';
        }
      });
      musicEl.addEventListener('ended', function () { musicBtn.textContent = '▶'; });
    }

    // Apply frame
    setTimeout(function () {
      try {
        var av = card.querySelector('#qp-avatar');
        if (av && window.QamarFrames && typeof window.QamarFrames.apply === 'function') {
          var frame = user.avatarFrame;
          if (!frame && window.QamarFrames.defaultForRank) {
            frame = window.QamarFrames.defaultForRank(Number(user.rankLevel) || 50);
          }
          if (frame) window.QamarFrames.apply(av, frame);
        }
      } catch (e) {}
    }, 50);

    // Apply name effect
    setTimeout(function () {
      try {
        var nameEl = card.querySelector('#qp-name');
        if (!nameEl || !window.QamarNameEffects || typeof window.QamarNameEffects.apply !== 'function') return;
        var cfg = user.nameEffects;
        if (!cfg) {
          if (user.nameGradient && user.nameGradient.length === 2) {
            cfg = { mode: 'gradient', c1: user.nameGradient[0], c2: user.nameGradient[1], c3: user.nameGradient[1] };
          } else if (user.nameColor) {
            cfg = { mode: 'solid', value: user.nameColor };
          }
        }
        if (cfg) window.QamarNameEffects.apply(nameEl, cfg);
      } catch (e) {}
    }, 80);

    document.addEventListener('keydown', onEsc);
    St.open = true;
  }

  function onEsc(e) { if (e.key === 'Escape' && St.open) close(); }

  /* ==================== Actions ==================== */

  function handleAction(action, user) {
    var uid = St.currentUid;
    if (!uid) return;

    if (action === 'pm') {
      close();
      try {
        if (window.QamarNav && typeof window.QamarNav.openPM === 'function') {
          window.QamarNav.openPM(uid);
        } else {
          emit('pm:open', { otherUid: uid });
        }
      } catch (e) {}
      return;
    }

    if (action === 'frames') {
      if (!window.QamarFrames) { toast('غير متاح', 'error'); return; }
      showFramesSelector(uid, user.avatarFrame);
      return;
    }

    if (action === 'name-effect') {
      if (!window.QamarNameEffects) { toast('غير متاح', 'error'); return; }
      try { window.QamarNameEffects.open(uid); }
      catch (e) { toast('فشل', 'error'); }
      return;
    }

    if (action === 'edit') {
      toast('تعديل البروفايل قادم قريباً', 'info');
      return;
    }

    if (action === 'share') {
      try {
        var url = location.origin + location.pathname + '#profile=' + uid;
        if (navigator.share) {
          navigator.share({ title: 'بروفايل ' + (user.name || '') , url: url });
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url);
          toast('✅ تم نسخ الرابط', 'success');
        }
      } catch (e) { toast('مشاركة غير متاحة'); }
      return;
    }

    if (action === 'add-friend') { toast('قريباً', 'info'); return; }
    if (action === 'report') { toast('الإبلاغ قادم', 'info'); return; }

    if (action === 'block') {
      if (!window.QamarPM || typeof window.QamarPM.blockUser !== 'function') {
        toast('غير متاح'); return;
      }
      if (!confirm('حظر ' + (user.name || '?') + '؟')) return;
      window.QamarPM.blockUser(uid).then(function () {
        toast('✅ تم الحظر', 'success'); close();
      }).catch(function (e) { toast(e.message || 'فشل', 'error'); });
      return;
    }
  }

  function showFramesSelector(uid, currentFrame) {
    var frames = (window.QamarFrames && window.QamarFrames.list) ? window.QamarFrames.list() : [];
    if (!frames.length) { toast('لا توجد إطارات', 'error'); return; }

    var ov = document.createElement('div');
    ov.className = 'qpf-ov';

    var card = document.createElement('div');
    card.className = 'qpf-card';

    var grid = frames.map(function (f) {
      var active = currentFrame === f.id;
      var grad = 'linear-gradient(135deg,' + f.colors.join(',') + ')';
      return '<button class="qpf-tile" data-frame="' + esc(f.id) + '" type="button" ' +
        'style="border-color:' + (active ? '#d4af37' : 'rgba(255,255,255,.08)') + '">' +
        '<span class="qpf-dot" style="background:' + grad + '"></span>' +
        '<span>' + esc(f.name) + '</span>' +
      '</button>';
    }).join('');

    card.innerHTML =
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">' +
        '<div style="color:#d4af37;font-size:15px;font-weight:900">🎨 اختر إطاراً</div>' +
        '<button id="qpf-close" type="button" ' +
          'style="width:32px;height:32px;border-radius:50%;background:transparent;' +
          'border:1px solid rgba(255,255,255,.12);color:#9ca3af;cursor:pointer;font-family:inherit">✕</button>' +
      '</div>' +
      '<div class="qpf-grid">' + grid + '</div>';

    ov.appendChild(card);
    document.body.appendChild(ov);

    card.querySelector('#qpf-close').addEventListener('click', function () { ov.remove(); });
    ov.addEventListener('click', function (e) { if (e.target === ov) ov.remove(); });

    card.querySelectorAll('.qpf-tile').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var frameId = btn.getAttribute('data-frame');
        var av = $id('qp-avatar');
        try { if (av && window.QamarFrames.apply) window.QamarFrames.apply(av, frameId); } catch (e) {}
        if (window.QamarIdentity && typeof window.QamarIdentity.setFrame === 'function') {
          window.QamarIdentity.setFrame(frameId).then(function () {
            toast('✅ تم الحفظ', 'success');
          }).catch(function () { toast('فشل الحفظ', 'error'); });
        }
        ov.remove();
      });
    });
  }

  /* ==================== Public ==================== */

  function open(uid, opts) {
    opts = opts || {};
    if (!uid) uid = getCurrentUid();
    if (!uid) { toast('غير مسجل', 'error'); return; }

    St.currentUid = uid;
    St.isSelf = (uid === getCurrentUid());

    Promise.all([fetchUser(uid), fetchPoints(uid)]).then(function (r) {
      var user = r[0] || { name: '—', uid: uid };
      build(user, r[1]);
      emit('profile:opened', { uid: uid, isSelf: St.isSelf });
    });
  }

  function openSelf() {
    var uid = getCurrentUid();
    if (uid) open(uid);
  }

  function close() {
    var ov = $id(MODAL_ID);
    if (ov) {
      var card = ov.querySelector('.qp-card');
      if (card) {
        card.style.transition = 'transform .25s ease, opacity .25s ease';
        card.style.transform = 'translateY(60px)';
        card.style.opacity = '0';
      }
      setTimeout(function () { try { ov.remove(); } catch (e) {} }, 280);
    }
    St.open = false;
    St.currentUid = null;
    St.isSelf = false;
    document.removeEventListener('keydown', onEsc);
    emit('profile:closed', {});
  }

  function init() {
    if (St.inited) return;
    St.inited = true;
    injectStyle();
    try {
      if (window.EventBus && typeof window.EventBus.on === 'function') {
        window.EventBus.on('profile:open', function (d) { if (d && d.uid) open(d.uid); });
        window.EventBus.on('profile:open-self', openSelf);
      }
    } catch (e) {}
    console.log('[profile] v' + VERSION + ' ready');
  }

  window.QamarProfile = {
    version: VERSION,
    open: open,
    openSelf: openSelf,
    close: close,
    isOpen: function () { return St.open; },
    init: init
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    setTimeout(init, 200);
  }
})();
